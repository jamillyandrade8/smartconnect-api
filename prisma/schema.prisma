generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo estruturado de clientes de atendimento omnichannel
model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
}
